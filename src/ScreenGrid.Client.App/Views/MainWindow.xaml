<ui:FluentWindow
    x:Class="ScreenGrid.Client.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:ScreenGrid.Client.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:ScreenGrid.Client.App.ViewModels"
    Title="ScreenGrid"
    Width="980"
    Height="640"
    MinWidth="820"
    MinHeight="540"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding AppName}">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Desktop24" />
            </ui:TitleBar.Icon>

            <ui:TitleBar.TrailingContent>
                <StackPanel Margin="0,0,8,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,4,0"
                        Appearance="Transparent"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTip="{x:Static res:Strings.ToggleTheme}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="{Binding ThemeIcon}" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Appearance="Transparent"
                        Command="{Binding NavigateSettingsCommand}"
                        Icon="{ui:SymbolIcon Settings24}"
                        ToolTip="{x:Static res:Strings.Settings}" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />

        <Border
            Grid.Row="2"
            Padding="16,8"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding StatusText}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding AppName}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="  ·  " />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding VersionText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
