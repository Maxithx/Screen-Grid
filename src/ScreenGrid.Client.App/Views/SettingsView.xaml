<UserControl
    x:Class="ScreenGrid.Client.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:ScreenGrid.Client.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:ScreenGrid.Client.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16" Orientation="Horizontal">
            <ui:Button
                Appearance="Transparent"
                Command="{Binding BackCommand}"
                Icon="{ui:SymbolIcon ArrowLeft24}"
                ToolTip="{x:Static res:Strings.Back}" />
            <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{x:Static res:Strings.Settings}" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{x:Static res:Strings.SettingsGeneral}" />
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,20" Padding="20">
                <ui:ToggleSwitch
                    Content="{x:Static res:Strings.SettingsStartWithWindows}"
                    IsChecked="{Binding StartWithWindows}" />
            </Border>

            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{x:Static res:Strings.SettingsSecurity}" />
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,20" Padding="20">
                <StackPanel>
                    <ui:ToggleSwitch
                        Margin="0,0,0,12"
                        Content="{x:Static res:Strings.SettingsRequirePassword}"
                        IsChecked="{Binding RequirePassword}" />
                    <ui:ToggleSwitch
                        Content="{x:Static res:Strings.SettingsAutoAccept}"
                        IsChecked="{Binding AutoAcceptVerifiedDevices}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{x:Static res:Strings.SettingsAbout}" />
            <Border Style="{StaticResource PanelCardStyle}" Padding="20">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        VerticalAlignment="Top"
                        FontSize="24"
                        Foreground="{DynamicResource BrandAccentBrush}"
                        Symbol="Shield24" />
                    <TextBlock
                        Margin="12,0,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static res:Strings.SettingsAboutText}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
