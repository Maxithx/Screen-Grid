<UserControl
    x:Class="ScreenGrid.Client.App.Controls.VideoSurface"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        Reusable video presentation surface.

        Phase 1 is a placeholder: it renders a dark frame with a hint and is not
        yet fed by a decoder. The same control is intended to be reused by the
        future community/chat application, so it deliberately has no dependency
        on the remote-control pipeline.
    -->
    <Border
        Background="#FF0A0A0C"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <ui:SymbolIcon
                HorizontalAlignment="Center"
                FontSize="40"
                Foreground="#FF5A5A66"
                Symbol="Desktop24" />
            <TextBlock
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                FontSize="14"
                Foreground="#FF8A8A96"
                Text="{Binding PlaceholderText, ElementName=Root}" />
        </StackPanel>
    </Border>
</UserControl>
